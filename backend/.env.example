# Backend environment configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mikrotik_ai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mikrotik_ai

# RouterOS credentials
ROUTEROS_HOSTS=10.0.0.1,10.0.0.2
ROUTEROS_USERNAME=admin
ROUTEROS_PASSWORD=changeme

# AI provider keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.0-advanced
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-pro-latest

# Feature flags
AUTO_EXECUTE=false
SNAPSHOT_BEFORE_EXECUTE=true
ENABLE_KNOWLEDGE_CRAWLER=true

# CORS origins (comma separated)
BACKEND_CORS_ORIGINS=http://localhost:5173
