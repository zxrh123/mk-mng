# Database Configuration
DATABASE_URL=postgresql+asyncpg://mikrotik_user:your_password@localhost:5432/mikrotik_ai
DATABASE_SYNC_URL=postgresql://mikrotik_user:your_password@localhost:5432/mikrotik_ai

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AI Models Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MikroTik Default Settings
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_SSH_PORT=22
MIKROTIK_API_SSL=true

# System Configuration
AUTO_EXECUTE=false
ENABLE_AUTO_HEAL=true
ENABLE_LEARNING=true
MAX_CONCURRENT_TASKS=10
LOG_LEVEL=INFO

# Frontend URL
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Monitoring
MONITORING_INTERVAL=30
ALERT_THRESHOLD_CPU=85
ALERT_THRESHOLD_RAM=90
ALERT_THRESHOLD_LATENCY=200
