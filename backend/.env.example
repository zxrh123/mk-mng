APP_NAME="MikroTik AI Control Plane"
ENVIRONMENT=development
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mikrotik_ai
REDIS_URL=redis://localhost:6379/0

# RouterOS access
ROUTEROS_HOST=192.168.88.1
ROUTEROS_USER=admin
ROUTEROS_PASSWORD=your-strong-password
ROUTEROS_TLS=false

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Feature flags
AUTO_EXECUTE=false
CLIENT_ORIGIN=http://localhost:5173
