# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mikrotik_db

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MikroTik Default
MIKROTIK_DEFAULT_HOST=192.168.88.1
MIKROTIK_DEFAULT_USER=admin
MIKROTIK_DEFAULT_PASSWORD=

# AI Settings
AI_AUTO_EXECUTE=false
AI_DRY_RUN=true
AI_ENABLE_LEARNING=true

# Monitoring
MONITORING_INTERVAL=5
ALERT_THRESHOLD_CPU=80
ALERT_THRESHOLD_RAM=85
ALERT_THRESHOLD_LATENCY=100
